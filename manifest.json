{
  "manifest_version": 3,
  "name": "CapChecker",
  "short_name": "CapChecker",
  "version": "0.1.6",
  "description": "Stamps hype and scam posts on X with a CAP score and the reasons behind it. AI checks run on your own Darkwoods key.",
  "author": "500altcoins",
  "homepage_url": "https://github.com/500bitcoins/capchecker",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CapChecker",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.darkwoods.ai/*", "https://api.fxtwitter.com/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": [
        "src/shared/settings.js",
        "src/shared/rules.js",
        "src/shared/verdict.js",
        "src/content/extract.js",
        "src/content/ui.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
